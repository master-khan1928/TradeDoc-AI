# Шаблон переменных окружения. Значений здесь нет и быть не должно: ключи задаются только в окружении
# сеанса или хостинга либо в локальном файле .env (он в .gitignore и в репозиторий не попадает).

# Режим чтения: mock | gemini | groq | openrouter | meta
LLM_PROVIDER=
# Резервный провайдер при лимите или сбое (необязательно)
LLM_FALLBACK=
# Свой лимит запросов в минуту (по умолчанию 10 для бесплатных, 60 для Meta)
LLM_RPM=
LLM_TIMEOUT_MS=
# on/off кэша для бесплатных провайдеров (по умолчанию on)
LLM_CACHE=

GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Meta: слой подготовлен, ждём ключ. Не используйте модели с суффиксом -contributor с реальными документами.
META_API_KEY=
META_MODEL=
META_BASE_URL=

# Сервер
PORT=
RATE_LIMIT_PER_MIN=
TRUST_PROXY=
ALLOWED_ORIGINS=
